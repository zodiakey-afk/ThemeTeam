{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "themeteam-m1-assets-v0.2",
  "title": "ThemeTeam M1 runtime bitmap and animation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rightsReview", "atlases", "animations", "fallbacks"],
  "properties": {
    "version": {"const": "0.2"},
    "rightsReview": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "reviewedAt", "distributionScope"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected"]},
        "reviewer": {"type": ["string", "null"], "maxLength": 256},
        "reviewedAt": {"type": ["string", "null"], "format": "date-time"},
        "distributionScope": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "atlases": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "image", "sha256", "width", "height", "source", "author", "license", "frames"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "image": {"type": "string", "pattern": "^/assets/office/(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.png$", "maxLength": 256},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "width": {"type": "integer", "minimum": 1, "maximum": 4096},
          "height": {"type": "integer", "minimum": 1, "maximum": 4096},
          "source": {"type": "string", "minLength": 1, "maxLength": 512},
          "author": {"type": "string", "minLength": 1, "maxLength": 256},
          "license": {"type": "string", "minLength": 1, "maxLength": 512},
          "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/frame"}}
        }
      }
    },
    "animations": {
      "type": "array", "minItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "activity", "direction", "frameIds", "fps", "loop"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "role": {"enum": ["pm", "developer", "tester", "fallback"]},
          "activity": {"enum": ["idle", "walk", "dock", "sit", "work", "think", "blocked"]},
          "direction": {"enum": ["NE", "SE", "SW", "NW"]},
          "frameIds": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/id"}},
          "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 24},
          "loop": {"type": "boolean"}
        }
      }
    },
    "fallbacks": {
      "type": "object", "additionalProperties": false,
      "required": ["unknownRole", "unknownActivity", "missingFrame"],
      "properties": {
        "unknownRole": {"$ref": "#/definitions/id"},
        "unknownActivity": {"$ref": "#/definitions/id"},
        "missingFrame": {"$ref": "#/definitions/id"}
      }
    }
  },
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height", "pivotX", "pivotY", "kind"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "pivotX": {"type": "integer", "minimum": 0}, "pivotY": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["tile", "propBack", "propFront", "agent", "effect"]}
      }
    }
  },
  "x-semanticChecks": [
    "atlas ids, frame ids and animation ids are globally unique",
    "every frame rectangle is within its atlas and pivots are within inclusive frame bounds",
    "every animation frameId resolves and uses an agent frame for agent activities",
    "pm/developer/tester expose idle and walk in all four directions plus dock/sit/work fallbacks",
    "all direction variants for one role/activity use the same ground-pivot convention",
    "rightsReview.status must be approved before packaging; source/author/license must be independently audited",
    "all images are local allowlisted build assets; snapshot strings cannot become image URLs or frame ids without role/activity allowlist mapping"
  ]
}
