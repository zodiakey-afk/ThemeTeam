{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "themeteam-m1-map-v0.1",
  "title": "ThemeTeam M1 office map contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dimensions", "origin", "roomBindings", "collision", "doors", "anchors", "spawns", "renderLayers"],
  "properties": {
    "version": {"const": "0.1"},
    "dimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["columns", "rows", "tileWidth", "tileHeight"],
      "properties": {
        "columns": {"const": 32}, "rows": {"const": 24},
        "tileWidth": {"const": 64}, "tileHeight": {"const": 32}
      }
    },
    "origin": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
    },
    "roomBindings": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "roomType", "cells"],
        "properties": {
          "key": {"enum": ["boss", "work", "meeting", "coffee"]},
          "roomType": {"type": "string", "minLength": 1, "maxLength": 64},
          "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/cell"}}
        }
      }
    },
    "collision": {
      "type": "array", "minItems": 24, "maxItems": 24,
      "items": {"type": "string", "minLength": 32, "maxLength": 32, "pattern": "^[01]{32}$"}
    },
    "doors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "cell", "roomKeys", "open"],
        "properties": {
          "id": {"$ref": "#/definitions/id"}, "cell": {"$ref": "#/definitions/cell"},
          "roomKeys": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["boss", "work", "meeting", "coffee"]}},
          "open": {"type": "boolean"}
        }
      }
    },
    "anchors": {
      "type": "array", "minItems": 14,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "roomKey", "approach", "sit", "facing", "footprint"],
        "properties": {
          "id": {"$ref": "#/definitions/id"}, "kind": {"enum": ["workSeat", "meetingSeat"]},
          "roomKey": {"enum": ["boss", "work", "meeting", "coffee"]},
          "approach": {"$ref": "#/definitions/cell"},
          "sit": {
            "type": "object", "additionalProperties": false, "required": ["x", "y"],
            "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
          },
          "facing": {"enum": ["NE", "SE", "SW", "NW"]},
          "footprint": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/cell"}}
        }
      }
    },
    "spawns": {"type": "array", "minItems": 20, "items": {"$ref": "#/definitions/cell"}},
    "renderLayers": {
      "type": "array", "const": ["ground", "propsBack", "dynamic", "propsFront", "effects"]
    }
  },
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "cell": {
      "type": "object", "additionalProperties": false, "required": ["col", "row"],
      "properties": {"col": {"type": "integer", "minimum": 0, "maximum": 31}, "row": {"type": "integer", "minimum": 0, "maximum": 23}}
    }
  },
  "x-semanticChecks": [
    "room keys, door ids and anchor ids are unique and the four room keys occur exactly once",
    "collision[row][col]=0 for every open door, anchor approach and spawn",
    "exactly 8 workSeat and 6 meetingSeat anchors",
    "anchor footprints do not overlap and each anchor roomKey matches its room binding",
    "every approach is four-neighbor reachable from at least one spawn through collision=0 and open doors",
    "all 20 pressure spawns are unique, walkable and do not overlap footprints",
    "door roomKeys exist; closed doors are treated as collision regardless of collision string",
    "sit coordinates and facing are finite; projection uses m1-v0.1 tile/origin contract"
  ]
}
